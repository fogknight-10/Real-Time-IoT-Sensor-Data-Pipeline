# Copy this file to .env and set real values. NEVER commit .env.
# Names below are placeholders: align them with docker-compose.yml.

# --- SQL Server (password must meet SQL Server complexity rules) ---
MSSQL_SA_PASSWORD=change_me_Str0ng!
MSSQL_PORT=1433

# --- Airflow ---
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me

# --- Grafana ---
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_RAW_TOPIC=iot.sensor.raw
KAFKA_DEAD_LETTER_TOPIC=iot.sensor.dead_letter

# --- Simulator (defaults from the project baseline) ---
SIM_DEVICES=500
SIM_SITES=5
SIM_EVENTS_PER_SECOND=500
SIM_PCT_LATE=1
SIM_PCT_DUPLICATE=1
SIM_PCT_MALFORMED=1
SIM_PCT_OUT_OF_RANGE=1
